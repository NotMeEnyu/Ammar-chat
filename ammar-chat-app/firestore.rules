rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function notBanned() {
      return signedIn() && userDoc(request.auth.uid).data.banned != true;
    }
    function isOwner() {
      return signedIn() &&
        userDoc(request.auth.uid).data.role == 'owner';
    }
    function validUserCreate(uid) {
      return request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'user' &&
        request.resource.data.banned == false;
    }

    match /users/{uid} {
      allow read: if notBanned();
      allow create: if signedIn() && validUserCreate(uid);
      allow update: if notBanned() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role','banned','uid','email','createdAt']);
      allow delete: if isOwner();
    }

    match /chats/{chatId} {
      allow read: if notBanned() && request.auth.uid in resource.data.members;
      allow create: if notBanned() && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow update: if notBanned() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage','updatedAt']);
      allow delete: if isOwner();
      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if notBanned() && request.auth.uid in parentChat().members;
        allow create: if notBanned() && request.auth.uid in parentChat().members
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow delete: if notBanned() &&
          (resource.data.senderId == request.auth.uid || isOwner());
        allow update: if false;
      }
    }

    match /groups/{groupId} {
      allow read: if notBanned() &&
        (resource.data.public == true || request.auth.uid in resource.data.members);
      allow create: if notBanned() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members.size() == 1;
      allow update: if notBanned() && (
        (request.auth.uid == resource.data.ownerId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name','description','public','members','moderators','lastMessage','updatedAt'])) ||
        (!(request.auth.uid in resource.data.members) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members']) &&
          request.auth.uid in request.resource.data.members &&
          request.resource.data.members.size() == resource.data.members.size() + 1) ||
        (request.auth.uid in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage','updatedAt']))
      );
      allow delete: if isOwner() || request.auth.uid == resource.data.ownerId;
      match /messages/{messageId} {
        function parentGroup() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }
        allow read: if notBanned() &&
          (parentGroup().public == true || request.auth.uid in parentGroup().members);
        allow create: if notBanned() &&
          request.auth.uid in parentGroup().members &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000;
        allow delete: if notBanned() &&
          (resource.data.senderId == request.auth.uid ||
           request.auth.uid == parentGroup().ownerId ||
           request.auth.uid in parentGroup().moderators ||
           isOwner());
        allow update: if false;
      }
    }
  }
}
